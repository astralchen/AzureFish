            "value" : "12 حرفًا على الأقل، وبحد أقصى 72 بايت بترميز UTF-8. قد يشغل الحرف عدة بايتات."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At least 12 characters and at most 72 UTF-8 bytes. Some characters use multiple bytes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少 12 个字符，且不超过 72 个 UTF-8 字节。中文等字符可能占多个字节。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少 12 個字元，且不超過 72 個 UTF-8 位元組。中文等字元可能佔多個位元組。"
          }
        }
      }
    },
