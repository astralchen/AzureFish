    "chat.list.deleteHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将清空本机聊天记录并从列表移除。草稿和待发送内容会保留，不会删除好友或退出群聊。收到或发送新消息后会重新显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將清空本機聊天記錄並從列表移除。草稿和待傳送內容會保留，不會刪除好友或退出群組。收到或傳送新訊息後會重新顯示。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This clears chat history on this device and removes the chat from the list. Drafts and pending messages are kept. Your contact and group membership are unchanged. The chat reappears when you send or receive a new message."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُمسح سجل المحادثة على هذا الجهاز وتُزال المحادثة من القائمة. ستبقى المسودات والرسائل قيد الإرسال، ولن تُحذف جهة الاتصال ولن تغادر المجموعة. ستظهر المحادثة مجددًا عند إرسال رسالة جديدة أو استقبالها."
          }
        }
      }
    },
