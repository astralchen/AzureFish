    "chat.live.clearHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清空本设备截至当前的聊天记录，之后补拉的旧记录也会隐藏。不会删除对方记录、草稿、待发送内容，也不会退出群聊或改变已读状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除本機截至目前的聊天記錄，之後補載的舊記錄也會隱藏。不會刪除對方記錄、草稿或待傳送內容，也不會退出群組或變更已讀狀態。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hide chat history up to the current message on this device, including older history loaded later. Other people’s records, drafts, pending messages, membership and read status stay unchanged."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إخفاء سجل المحادثة حتى الرسالة الحالية على هذا الجهاز، بما في ذلك السجل الأقدم الذي يُحمّل لاحقًا. لا تتغير سجلات الآخرين أو المسودات أو الرسائل المعلقة أو العضوية أو حالة القراءة."
          }
        }
      }
    },
