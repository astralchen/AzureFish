    "account.design.recoveryHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتفظ ببياناتك. افتح قفل الجهاز وحاول مجددًا. إذا استمرت المشكلة، حافظ على الملفات الأصلية واطلب الدعم دون استبدالها."
