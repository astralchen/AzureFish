    "account.security.newPassword": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新密码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新密碼"
          }
        },
        "en": {
