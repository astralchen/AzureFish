    "contacts.blockHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拉黑后，双方不能发送私聊、好友申请或互相邀请入群。好友关系、已有群聊和历史记录保留；解除后恢复原有关系。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "封鎖後，雙方無法傳送私訊、好友申請或互相邀請入群。好友關係、現有群聊及歷史紀錄保留；解除後恢復原有關係。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocking stops private messages, friend requests and group invitations between you. Your contact relationship, existing groups and history are kept. Unblocking restores the previous relationship."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوقف الحظر الرسائل الخاصة وطلبات الصداقة ودعوات المجموعات بينكما. تُحفظ العلاقة والمجموعات الحالية والسجل. يعيد إلغاء الحظر العلاقة السابقة."
          }
        }
      }
    },
