    "chat.live.deleteHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅从你的通讯录移除对方，历史记录和草稿保留。双方将暂停新的私聊；若对方仍保留你，重新添加可直接恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅從你的通訊錄移除對方，歷史紀錄與草稿保留。雙方將暫停新的私訊；若對方仍保留你，重新加入即可恢復。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove this person from your contacts only. History and drafts are kept. New private messages pause for both of you. Adding them again restores contact immediately if they still keep you."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُزال جهة الاتصال من قائمتك فقط ويُحفظ السجل والمسودات. تتوقف الرسائل الخاصة الجديدة لكليكما. تعيد الإضافة العلاقة فورًا إذا كان الطرف الآخر لا يزال يحتفظ بك."
          }
        }
      }
    },
