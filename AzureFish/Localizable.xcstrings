{
  "sourceLanguage" : "en",
  "strings" : {
    "account.security.resultUnknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deletion result could not be recovered. Local encrypted data has been kept. Sign in to check the account status."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法恢复删除结果，已保留本机加密数据。请登录确认账号状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法復原刪除結果，已保留本機加密資料。請登入確認帳號狀態。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر استعادة نتيجة الحذف. تم الاحتفاظ بالبيانات المحلية المشفرة. سجّل الدخول للتحقق من حالة الحساب."
          }
        }
      }
    },
    "chat.permission.microphone": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中允许麦克风访问，然后重新录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定中允許麥克風存取，然後重新錄音。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow microphone access in Settings, then try recording again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى الميكروفون في الإعدادات ثم حاول التسجيل مجددًا."
          }
        }
      }
    },
    "chat.permission.settings": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟設定"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح الإعدادات"
          }
        }
      }
    },
    "chat.media.export": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存或分享附件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存或分享附件"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save or share attachments"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حفظ المرفقات أو مشاركتها"
          }
        }
      }
    },
    "account.deletedUser": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已注销用户"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已註銷使用者"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted user"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستخدم محذوف"
          }
        }
      }
    },
    "account.deletion.accepted": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除申请已受理。服务端清理可能仍在进行，其他成员已接收的历史记录会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除申請已受理。伺服器清理可能仍在進行，其他成員已接收的歷史記錄會保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletion accepted. Server cleanup may still be in progress. History already received by other members is retained."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم قبول طلب الحذف. قد يستمر التنظيف على الخادم. يحتفظ الأعضاء الآخرون بالسجل الذي استلموه."
          }
        }
      }
    },
    "account.security.completed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作成功，请重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作成功，請重新登入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done. Please sign in again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت العملية. يرجى تسجيل الدخول مجددًا."
          }
        }
      }
    },
    "account.security.reauthenticate": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "身份确认已过期，请重新输入当前密码再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "身分確認已過期，請重新輸入目前密碼再試。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verification expired. Enter your current password and try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية التحقق. أدخل كلمة المرور الحالية وحاول مجددًا."
          }
        }
      }
    },
    "account.security.currentPassword": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
