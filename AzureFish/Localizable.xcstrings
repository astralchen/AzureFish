          }
        }
      }
    },
    "account.security.logoutHelp": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作成功后，所有设备（包括当前设备）都会退出登录。本机加密聊天记录会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作成功後，所有裝置（包括目前裝置）都會登出。本機加密聊天記錄會保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All devices, including this one, will be signed out. Encrypted chat history on this device is retained."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم تسجيل الخروج من جميع الأجهزة، بما فيها هذا الجهاز. سيُحتفظ بسجل المحادثات المشفر على هذا الجهاز."
          }
        }
      }
    },
    "account.security.deleteHelp": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除后账号将停用，个人资料、头像和本机数据将清除。其他成员保留已接收的历史记录。此操作不可撤销，请先处理你管理的群聊。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除後帳號將停用，個人資料、頭像和本機資料將清除。其他成員保留已接收的歷史記錄。此操作無法復原，請先處理你管理的群組。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account will be disabled and your profile, avatar and local data removed. Other members retain received history. This cannot be undone. Transfer or dissolve groups you own first."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُعطّل حسابك وتُحذف معلوماتك وصورتك وبياناتك المحلية. يحتفظ الآخرون بالسجل المستلم. لا يمكن التراجع. انقل ملكية مجموعاتك أو حلّها أولًا."
          }
        }
      }
    },
    "account.security.ownedGroups": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先转让或解散以下群聊，再返回删除账号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先轉讓或解散以下群組，再返回刪除帳號。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer or dissolve these groups before deleting your account."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقل ملكية هذه المجموعات أو حلّها قبل حذف حسابك."
          }
        }
      }
    },
    "account.avatar.help": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "头像确认后立即更新，取消文字编辑不会撤销头像修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認頭像後立即更新，取消文字編輯不會復原頭像修改。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your avatar updates after confirmation. Cancelling text edits does not undo an avatar change."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحدّث الصورة بعد التأكيد. إلغاء تعديلات النص لا يلغي تغيير الصورة."
          }
        }
      }
    },
    "account.avatar.choose": {
