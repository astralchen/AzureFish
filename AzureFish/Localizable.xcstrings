    "account.cache.damaged" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر قراءة البيانات المحلية بأمان. أعد المحاولة أو راجع إرشادات الاستعادة. لن تُستبدل بياناتك بملف فارغ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local data couldn’t be read securely. Retry or review recovery guidance. Existing data will not be replaced with an empty profile."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法安全读取本机资料。请重试或查看恢复说明，原有数据不会被空资料覆盖。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法安全讀取本機資料。請重試或查看復原說明，原有資料不會被空白資料覆寫。"
          }
        }
      }
    },
    "account.cache.key" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتفظ ببياناتك. افتح قفل الجهاز وحاول مجددًا. إذا استمرت المشكلة، حافظ على الملفات الأصلية واطلب الدعم دون استبدالها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep existing data. Unlock the device and retry. If it remains unavailable, preserve the original files and seek support. Do not overwrite them."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留当前数据。确认设备已解锁后重试；若仍不可用，请保留原文件并寻求支持。不要覆盖或重建为空数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留目前資料。確認裝置已解鎖後重試；若仍無法使用，請保留原始檔案並尋求支援。請勿覆寫或重建為空白資料。"
          }
        }
      }
    },
    "account.cancel.auth" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
