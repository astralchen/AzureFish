    "NSMicrophoneUsageDescription" : {
      "comment" : "Explains why the Demo requests microphone access.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم العرض التوضيحي الميكروفون لتسجيل الرسائل الصوتية وتحويل الكلام إلى نص."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The demo uses the microphone to record audio messages and convert speech to text."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "演示需要使用麦克风录制音频消息并将语音转换为文字。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف التطبيق الصور والفيديوهات المستلمة إلى مكتبة الصور عند الضغط على حفظ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The demo adds received photos and videos to your photo library when you tap Save."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击保存时，演示应用会将收到的照片和视频添加到你的照片图库。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ التطبيق الموارد الأصلية للصور الحية التي تحددها للحفاظ على الحركة والصوت."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The demo reads the original resources of your selected Live Photos to preserve motion and sound."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取你所选实况照片的原始照片和配对视频，以保留实况播放与声音。可以仅允许访问所选照片。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Explains why the Demo requests speech-recognition access.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم العرض التوضيحي التعرف على الكلام لتحويل صوتك إلى مسودة رسالة وتحويل الرسائل الصوتية المرسلة والمستلمة إلى نص."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The demo uses speech recognition to turn your voice into a message draft and transcribe sent and received audio messages."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "演示需要使用语音识别将你说的话转换为消息草稿，并为发送和接收的音频消息生成文字。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}