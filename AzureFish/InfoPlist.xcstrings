    "NSMicrophoneUsageDescription" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制语音消息、语音转文字和拍摄视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錄製語音訊息、語音轉文字及拍攝影片。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Record audio messages, transcribe speech, and record video sound."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسجيل الرسائل الصوتية وتحويل الكلام إلى نص وتسجيل صوت الفيديو."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف التطبيق الصور والفيديوهات المستلمة إلى مكتبة الصور عند الضغط على حفظ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The demo adds received photos and videos to your photo library when you tap Save."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击保存时，演示应用会将收到的照片和视频添加到你的照片图库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下儲存時，示範 App 會將收到的照片與影片加入你的照片圖庫。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ التطبيق الموارد الأصلية للصور الحية التي تحددها للحفاظ على الحركة والصوت."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The demo reads the original resources of your selected Live Photos to preserve motion and sound."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取你所选实况照片的原始照片和配对视频，以保留实况播放与声音。可以仅允许访问所选照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讀取你所選原況照片的原始照片和配對影片，以保留原況播放與聲音。可僅允許取用所選照片。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Explains why the Demo requests speech-recognition access.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم العرض التوضيحي التعرف على الكلام لتحويل صوتك إلى مسودة رسالة وتحويل الرسائل الصوتية المرسلة والمستلمة إلى نص."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The demo uses speech recognition to turn your voice into a message draft and transcribe sent and received audio messages."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "演示需要使用语音识别将你说的话转换为消息草稿，并为发送和接收的音频消息生成文字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "示範功能需要使用語音辨識，將你說的話轉換為訊息草稿，並為傳送和接收的語音訊息產生文字。"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍摄朋友圈视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍攝朋友圈影片。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Record videos for Moments."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسجيل فيديوهات للحظات."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
